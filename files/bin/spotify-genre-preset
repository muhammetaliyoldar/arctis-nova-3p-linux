#!/usr/bin/python3
"""Linux ön yüzü: Spotify'da çalan şarkının türüne göre EasyEffects presetini değiştirir.

Şarkı değişimini Spotify'ın MPRIS sinyalinden alır, preseti `easyeffects -l` ile yükler, üst bar menüsünün
(GNOME uzantısı) yazdığı ~/.config/spotify-genre-preset/config.json'u izler. Tür bulma, Spotify hesabı, geçmiş,
dönem, istatistik ve menü mantığı platformdan bağımsız çekirdekte: files/core/genre_core.py (kurulu:
~/.local/share/spotify-genre-preset/genre_core.py).

Kullanım: spotify-genre-preset                      (servis)
          spotify-genre-preset --login [CLIENT_ID]  (Spotify hesabını bağlar; ID verilmezse kayıtlı olan, o da yoksa sorar)
"""
import os
import subprocess
import sys
import threading

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path[:0] = [os.path.join(HERE, "..", "core"), os.path.join(HERE, "..", "share", "spotify-genre-preset")]  # repo, kurulu
import genre_core as core  # noqa: E402

import gi  # noqa: E402
gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

EE_OUTPUT = (os.path.join(GLib.get_user_config_dir(), "easyeffects", "output"),  # 7.x native, flatpak
             os.path.expanduser("~/.var/app/com.github.wwmm.easyeffects/config/easyeffects/output"),
             os.path.join(GLib.get_user_data_dir(), "easyeffects", "output"),  # 8+ native, flatpak
             os.path.expanduser("~/.var/app/com.github.wwmm.easyeffects/data/easyeffects/output"))
MPRIS = "org.mpris.MediaPlayer2.spotify"


class EasyEffects:
    def current(self):
        r = subprocess.run(["gsettings", "get", "com.github.wwmm.easyeffects", "last-used-output-preset"],
                           capture_output=True, text=True)
        if r.returncode:  # EasyEffects 8+ GSettings kullanmıyor
            try:  # EasyEffects kapalıyken -a cevap verip çıkmıyor
                r = subprocess.run(["easyeffects", "-a", "output"], capture_output=True, text=True, timeout=5)
            except subprocess.TimeoutExpired:
                return ""
        return r.stdout.strip().strip("'")

    def has(self, name):
        return any(os.path.exists(os.path.join(d, name + ".json")) for d in EE_OUTPUT)

    def apply(self, name):
        subprocess.run(["easyeffects", "-l", name], check=False)  # ee-preset değil: şarkı değişiminde bildirim çıkmasın
        os.makedirs(core.STATE_DIR, exist_ok=True)  # üst bar menüsü izler (ee-preset de yazar)
        with open(os.path.join(core.STATE_DIR, "yuklu"), "w") as fh:
            fh.write(name)


def on_metadata(f, md):
    f.on_track(md.get("mpris:trackid", ""), (md.get("xesam:artist") or [""])[0], md.get("xesam:title", ""),
               md.get("xesam:album", ""))


def main():
    bus = Gio.bus_get_sync(Gio.BusType.SESSION)
    f = core.Follower(EasyEffects())
    f.write_state()

    def on_config(_monitor, _file, _other, event):
        if event != Gio.FileMonitorEvent.CHANGED:  # yazım bitince (CHANGES_DONE_HINT, CREATED, DELETED) oku
            f.reload_config()

    monitor = Gio.File.new_for_path(core.CONFIG).monitor_file(Gio.FileMonitorFlags.NONE, None)
    monitor.connect("changed", on_config)

    def on_signal(_conn, _sender, _path, _iface, _signal, params):
        iface, changed, _ = params.unpack()
        if iface == "org.mpris.MediaPlayer2.Player" and "Metadata" in changed:
            on_metadata(f, changed["Metadata"])

    bus.signal_subscribe(MPRIS, "org.freedesktop.DBus.Properties", "PropertiesChanged",
                         "/org/mpris/MediaPlayer2", None, Gio.DBusSignalFlags.NONE, on_signal)
    try:  # servis açılırken Spotify zaten çalıyorsa
        md = bus.call_sync(MPRIS, "/org/mpris/MediaPlayer2", "org.freedesktop.DBus.Properties", "Get",
                           GLib.Variant("(ss)", ("org.mpris.MediaPlayer2.Player", "Metadata")),
                           None, Gio.DBusCallFlags.NONE, 2000, None)
        on_metadata(f, md.unpack()[0])
    except GLib.Error:
        print("Spotify kapalı, açılması bekleniyor", flush=True)
    if f.spotify:
        threading.Thread(target=f.run_spotify, daemon=True).start()
    GLib.MainLoop().run()


if __name__ == "__main__":
    if sys.argv[1:2] == ["--login"]:
        core.login(sys.argv[2] if len(sys.argv) > 2 else
                   (core.load(core.SPOTIFY, None) or {}).get("client_id") or core.ask_client_id())
        subprocess.run(["systemctl", "--user", "try-restart", "spotify-genre-preset.service"], check=False)
        print("Servis çalışıyorsa yeniden başlatıldı.")
    else:
        main()
