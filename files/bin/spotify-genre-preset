#!/usr/bin/env python3
"""Spotify'da çalan şarkının türüne göre EasyEffects presetini değiştirir.

Türler genres.json'da (24 ana tür; her türün aynı adlı bir preseti var, uymayan her şey Genel):
~/.local/share/spotify-genre-preset/genres.json, yoksa betiğin yanındaki ../genres.json.
Tür (anahtar gerekmez): Deezer albüm türü ve MusicBrainz sanatçı etiketleri. Etiketler oy sırasıyla
taranır, ilk eşleşen etikette en uzun anahtar kelime kazanır ("deep house" > "house"). Etiket türü,
Deezer türü yoksa, aynı ailedense ya da Deezer türü genişse (pop, dance, elektro, alternatif,
techno/house) seçilir; değilse Deezer türü (MusicBrainz'deki ad karışıklığı başka aileden tür
getirmesin). Sanatçı ya da şarkı Türkçeyse (ğ ı ş harfleri ya da "turkish" etiketi) ve tür, Türkçe
karşılığı olan bir türse o seçilir (Hip Hop -> Türkçe Rap, Rock -> Türkçe Rock).
Sonuç albüm başına ~/.cache/spotify-genre-preset.json'a yazılır, tekrar sorulmaz.
Her şarkı değişiminde türün presetine geçilir (preset dosyası yoksa Genel); elle seçilen preset o
şarkı boyunca kalır. ~/.local/state/spotify-genre-preset/kilit dosyasında bir preset adı varsa (üst bar
menüsündeki kilit) türden bağımsız hep o preset çalar. Ağ hatasında preset değişmez.
Üst bar menüsü ~/.local/state/spotify-genre-preset/state.json'u okur (menü sırası, çalan tür,
sıralamalar). Menünün 5 türü ~/.config/spotify-genre-preset/config.json'daki moda göre: "sabit"
(seçilen 5 tür), "cihaz" (bu bilgisayarda her şarkıda bulunan türün sayımı), "hesap" (Spotify hesabının
son ~6 aydaki en çok dinlenen 50 parçası, 6 saatte bir; telefon dahil, her cihazda aynı). config.json
değişince menü hemen yeniden hesaplanır.

Kullanım: spotify-genre-preset                      (servis)
          spotify-genre-preset --login [CLIENT_ID]  (Spotify hesabını bir kez bağlar; ID verilmezse sorar)
"""
import base64
import hashlib
import json
import os
import re
import secrets
import subprocess
import sys
import threading
import time
import unicodedata
import webbrowser
from http.server import BaseHTTPRequestHandler, HTTPServer
import urllib.error
import urllib.parse
import urllib.request

import gi
gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

GENEL = "Genel"
BROAD_DEEZER = {"132", "113", "106", "85", "111", "152"}  # Pop, Dance, Electro, Alternative, Techno/House, Rock: etiket daha özel
TURKISH_LETTERS = set("ğışİĞŞ")

UA = "arctis-nova-3p-linux (https://github.com/muhammetaliyoldar/arctis-nova-3p-linux)"
CACHE = os.path.join(GLib.get_user_cache_dir(), "spotify-genre-preset.json")
STATE_DIR = os.path.join(GLib.get_user_state_dir(), "spotify-genre-preset")
STATE, LOCK = os.path.join(STATE_DIR, "state.json"), os.path.join(STATE_DIR, "kilit")
CONFIG_DIR = os.path.join(GLib.get_user_config_dir(), "spotify-genre-preset")
CONFIG, SPOTIFY = os.path.join(CONFIG_DIR, "config.json"), os.path.join(CONFIG_DIR, "spotify.json")
EE_OUTPUT = (os.path.join(GLib.get_user_config_dir(), "easyeffects", "output"),  # native, flatpak
             os.path.expanduser("~/.var/app/com.github.wwmm.easyeffects/config/easyeffects/output"))
REDIRECT = "http://127.0.0.1:8888/callback"
MPRIS = "org.mpris.MediaPlayer2.spotify"


def load_genres():
    """genres.json + aramalar için türetilen tablolar: family (tür -> aile), keywords (kelime -> tür)."""
    for path in (os.path.join(GLib.get_user_data_dir(), "spotify-genre-preset", "genres.json"),
                 os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "genres.json")):
        try:
            with open(path) as fh:
                cat = json.load(fh)
        except FileNotFoundError:
            continue
        cat["family"] = {g["name"]: g["family"] for g in cat["genres"]}
        cat["keywords"] = {k: g["name"] for g in cat["genres"] for k in g["keywords"]}
        return cat
    sys.exit("genres.json bulunamadı: ~/.local/share/spotify-genre-preset/genres.json yok "
             "(install.sh kurar; repodan çalıştırırken files/genres.json olmalı)")


CAT = load_genres()


def get_json(url, tries=3):
    for i in range(tries):
        try:
            req = urllib.request.Request(url, headers={"User-Agent": UA})
            with urllib.request.urlopen(req, timeout=8) as r:
                return json.load(r)
        except urllib.error.HTTPError as e:  # MusicBrainz yoğunken 503 dönüyor
            if e.code != 503 or i == tries - 1:
                raise
            time.sleep(2)


def same_name(a, b):
    """"Siyasiyabend" = "Siya siyabend", "AGAB" = "Aga B", "İ" = "i": harf ve rakam dışı her şey atılır."""
    norm = lambda s: "".join(c for c in unicodedata.normalize("NFKD", s.casefold()) if c.isalnum())
    return norm(a) == norm(b)


def deezer_genres(artist, title):
    """Şarkının albüm tür numaraları; şarkı bulunamazsa boş liste."""
    title = re.split(r" - |\(|\[", title)[0].strip()  # "... - Live Session", "(feat. X)" aramayı bozuyor
    q = urllib.parse.quote(f"{artist} {title}")
    for t in get_json(f"https://api.deezer.com/search?q={q}&limit=5").get("data", []):
        if same_name(t["artist"]["name"], artist):
            album = get_json(f"https://api.deezer.com/album/{t['album']['id']}")
            return [g["id"] for g in album.get("genres", {}).get("data", [])]
    return []


mb_next = 0.0


def musicbrainz_tags(artist):
    """Adı birebir eşleşen sanatçının (önce etiketlisi) etiketleri, en çok oy alan önce. Ülkesi TR ise sona
    "turkish" eklenir: Türkçe adı ğ/ı/ş içermeyen rapçiler (Kamufle, Laçin...) de Türkçe türe gitsin."""
    global mb_next
    time.sleep(max(0.0, mb_next - time.monotonic()))  # MusicBrainz kuralı: saniyede en fazla 1 istek
    mb_next = time.monotonic() + 1.1
    q = urllib.parse.quote(f'artist:"{artist}"')
    exact = [a for a in get_json(f"https://musicbrainz.org/ws/2/artist/?query={q}&limit=5&fmt=json")["artists"]
             if a.get("score") == 100]
    a = next((a for a in exact if a.get("tags")), exact[0] if exact else None)
    if not a:
        return []
    tags = [t["name"] for t in sorted(a.get("tags", []), key=lambda t: -t["count"])]
    return tags + ["turkish"] if a.get("country") == "TR" else tags


def genre_from_tags(tags):
    """Oyu en yüksek 5 etiketten oy sırasıyla ilk ÖZEL tür (House, Bass Müziği, Techno...); yoksa
    oradaki ilk eşleşen genel tür (Elektronik, Pop: genres.json "generic"); o da yoksa sonraki
    etiketlerden ilk eşleşen. Etiket birden çok kelime içeriyorsa en uzunu. Eşleşme yoksa (None, None)."""
    generic = set(CAT["generic"])
    matches = []  # (etiket sırası, tür, kelime)
    for i, t in enumerate(tags):
        words = [w for w in CAT["keywords"] if w in t]
        if words:
            word = max(words, key=len)
            matches.append((i, CAT["keywords"][word], word))
    top = [m for m in matches if m[0] < 5]
    pick = next((m for m in top if m[1] not in generic), None) or (top or matches or [None])[0]
    return (pick[1], pick[2]) if pick else (None, None)


def decide(deezer_ids, tags, artist, title):
    """Deezer albüm tür numaraları ve MusicBrainz etiketlerinden tür adı (ya da Genel)."""
    family = CAT["family"]
    tagged, word = genre_from_tags(tags)
    dz_id = next((str(i) for i in deezer_ids if str(i) in CAT["deezer"]), None)
    dz = CAT["deezer"].get(dz_id)
    if tagged and (not dz or family[tagged] == family.get(dz) or dz_id in BROAD_DEEZER):
        genre = tagged
        general = word == family[tagged] or tagged in CAT["deezer"].values()  # "rap", "pop" gibi genel kelime
    elif dz:
        genre, general = dz, True
    else:
        return GENEL
    turkish = any(c in TURKISH_LETTERS for c in artist + title) or any("turkish" in t or "türk" in t for t in tags)
    return CAT["turkish_variant"].get(family.get(genre), genre) if turkish and general else genre


def classify(artist, title):
    return decide(deezer_genres(artist, title), musicbrainz_tags(artist), artist, title)


def menu_for(cfg, st):
    """state.json "menu": mod listesinin ilk 5 türü (eksikse defaults'tan), Genel, 5'te değilse çalan preset."""
    source = {"sabit": cfg["sabit"], "cihaz": st.get("top_cihaz"),
              "hesap": st.get("top_hesap") or st.get("top_cihaz")}.get(cfg["mode"]) or []
    top = []
    for g in source + CAT["defaults"]:
        if g in CAT["family"] and g not in top:  # Genel ve katalogda olmayan adlar atlanır
            top.append(g)
    menu = top[:5] + [GENEL]
    playing = (st.get("current") or {}).get("preset")
    if playing in CAT["family"] and playing not in menu:
        menu.append(playing)
    return menu


def current_preset():
    return subprocess.run(["gsettings", "get", "com.github.wwmm.easyeffects", "last-used-output-preset"],
                          capture_output=True, text=True).stdout.strip().strip("'")


def locked_preset():
    try:
        with open(LOCK) as fh:
            return fh.read().strip() or None
    except FileNotFoundError:
        return None


def has_preset(name):
    return any(os.path.exists(os.path.join(d, name + ".json")) for d in EE_OUTPUT)


def load(path, default):
    try:
        with open(path) as fh:
            return json.load(fh)
    except FileNotFoundError:
        return default


def save(path, data, mode=0o644):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with os.fdopen(os.open(path + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode), "w") as fh:
        json.dump(data, fh, ensure_ascii=False, indent=1)
    os.replace(path + ".tmp", path)


def token_request(fields):
    data = urllib.parse.urlencode(fields).encode()
    with urllib.request.urlopen("https://accounts.spotify.com/api/token", data, timeout=10) as r:
        return json.load(r)


def ask_client_id():
    print("Spotify hesabını bağlamak için bir kez ücretsiz bir Spotify geliştirici uygulaması gerekiyor:\n"
          "  1. https://developer.spotify.com/dashboard adresinde \"Create app\" de.\n"
          f"  2. Redirect URI olarak tam olarak şunu ekle: {REDIRECT}\n"
          "  3. Uygulamanın Client ID'sini aşağıya yapıştır.")
    client_id = input("Client ID: ").strip()
    if not client_id:
        sys.exit("Client ID girilmedi, hesap bağlanmadı.")
    return client_id


def login(client_id):
    """PKCE ile tek seferlik giriş; sadece refresh token saklanır (dosya izni 600)."""
    verifier = secrets.token_urlsafe(64)
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    state, answer = secrets.token_urlsafe(16), {}

    class Callback(BaseHTTPRequestHandler):
        def do_GET(self):
            q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            if q.get("state") == [state]:  # favicon gibi diğer istekler yok sayılır
                answer.update(q)
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.end_headers()
            self.wfile.write("Tamam, bu sekmeyi kapatıp terminale dönebilirsin.".encode())

        def log_message(self, *_):
            pass

    server = HTTPServer(("127.0.0.1", 8888), Callback)
    url = "https://accounts.spotify.com/authorize?" + urllib.parse.urlencode({
        "client_id": client_id, "response_type": "code", "redirect_uri": REDIRECT, "scope": "user-top-read",
        "code_challenge_method": "S256", "code_challenge": challenge, "state": state})
    print("Tarayıcıda Spotify girişi açılıyor. Açılmazsa bu adresi aç:\n" + url, flush=True)
    webbrowser.open(url)
    while not answer:
        server.handle_request()
    if "code" not in answer:
        sys.exit("Giriş başarısız: " + answer.get("error", ["bilinmeyen hata"])[0])
    tok = token_request({"grant_type": "authorization_code", "code": answer["code"][0], "redirect_uri": REDIRECT,
                         "client_id": client_id, "code_verifier": verifier})
    save(SPOTIFY, {"client_id": client_id, "refresh_token": tok["refresh_token"]}, 0o600)
    if not os.path.exists(CONFIG):
        save(CONFIG, {"mode": "hesap", "sabit": CAT["defaults"]})
    subprocess.run(["systemctl", "--user", "try-restart", "spotify-genre-preset.service"], check=False)
    print("Spotify hesabı bağlandı; servis çalışıyorsa yeniden başlatıldı.")


def spotify_top_tracks(cfg):
    """Hesabın son ~6 ayda en çok dinlediği 50 parça (tüm cihazlar)."""
    tok = token_request({"grant_type": "refresh_token", "refresh_token": cfg["refresh_token"],
                         "client_id": cfg["client_id"]})
    if "refresh_token" in tok:  # Spotify bazen yenisini veriyor; eskisi geçersizleşir
        cfg["refresh_token"] = tok["refresh_token"]
        save(SPOTIFY, cfg, 0o600)
    req = urllib.request.Request("https://api.spotify.com/v1/me/top/tracks?time_range=medium_term&limit=50",
                                 headers={"Authorization": f"Bearer {tok['access_token']}"})
    with urllib.request.urlopen(req, timeout=10) as r:
        return json.load(r)["items"]


class Follower:
    def __init__(self):
        self.track = None
        self.cache = load(CACHE, {})
        st = load(STATE, {})
        self.counts = {g: n for g, n in st.get("counts", {}).items() if g in CAT["family"]}  # eski aile adları atılır
        self.current = st.get("current")
        self.spotify = load(SPOTIFY, None)
        self.top_hesap = st.get("top_hesap") if self.spotify else None
        self.read_config()
        self.lock = threading.Lock()  # önbellek servis ve sıralama iş parçacığı arasında ortak

    def read_config(self):
        try:
            cfg = load(CONFIG, {})
        except ValueError as e:
            print(f"config.json okunamadı ({e}), varsayılan mod kullanılıyor", flush=True)
            cfg = {}
        self.config = {"mode": cfg.get("mode") or ("hesap" if self.spotify else "cihaz"),
                       "sabit": cfg.get("sabit") or CAT["defaults"]}

    def write_state(self):
        st = {"mode": self.config["mode"], "current": self.current,
              "top_cihaz": sorted(self.counts, key=lambda g: -self.counts[g]), "counts": self.counts}
        if self.top_hesap is not None:  # hesap bağlı değilse anahtar yok
            st["top_hesap"] = self.top_hesap
        st["menu"] = menu_for(self.config, st)
        save(STATE, st)

    def genre_for(self, artist, album, title):
        key = f"{artist}\t{album}"
        with self.lock:
            genre = self.cache.get(key)
        if genre == GENEL or genre in CAT["family"]:
            return genre
        # Kayıt yok ya da eski sürümün aile adı. Ağ sorgusu kilit dışında: arka plandaki sıralama
        # 50 parçayı sorgularken çalan şarkının türü beklemesin.
        genre = classify(artist, title)
        with self.lock:
            self.cache[key] = genre
            save(CACHE, self.cache)
        return genre

    def refresh_top(self):
        try:
            items = spotify_top_tracks(self.spotify)
        except (OSError, ValueError, KeyError) as e:
            print(f"Spotify sıralaması alınamadı ({e}); 400 ya da 401 ise tekrar --login yap", flush=True)
            return False
        score = {}
        for rank, t in enumerate(items):  # 1. parça 50 puan, 50. parça 1 puan
            try:
                genre = self.genre_for(t["artists"][0]["name"], t["album"]["name"], t["name"])
            except (OSError, ValueError, KeyError) as e:  # bir sonraki güncellemede tekrar denenir
                print(f"{t['artists'][0]['name']} - {t['name']}: tür alınamadı ({e})", flush=True)
                continue
            if genre != GENEL:
                score[genre] = score.get(genre, 0) + len(items) - rank
        self.top_hesap = sorted(score, key=lambda g: -score[g])
        GLib.idle_add(self.write_state)  # state.json'u yalnız ana döngü yazar
        print("Spotify'a göre en çok dinlenen: " + ", ".join(self.top_hesap[:5]), flush=True)
        return True

    def on_metadata(self, md):
        track, title = md.get("mpris:trackid", ""), md.get("xesam:title", "")
        artist = (md.get("xesam:artist") or [""])[0]
        if not artist or track == self.track or "/ad/" in track or ":ad:" in track:
            return
        self.track = track
        current = current_preset()
        try:
            genre = self.genre_for(artist, md.get("xesam:album", ""), title)
            if genre != GENEL:
                self.counts[genre] = self.counts.get(genre, 0) + 1
        except (OSError, ValueError, KeyError) as e:
            print(f"{artist} - {title}: tür alınamadı ({e}), preset değişmedi", flush=True)
            genre = current
        locked = locked_preset()
        target = locked or genre
        print(f"{artist} - {title}: {genre}" + (f" (kilit: {locked})" if locked else ""), flush=True)
        if not has_preset(target):
            print(f"{target} preseti EasyEffects'te yok, Genel kullanılıyor", flush=True)
            target = GENEL
        if target != current:
            subprocess.run(["easyeffects", "-l", target], check=False)  # ee-preset değil: şarkı değişiminde bildirim çıkmasın
        self.current = {"genre": genre, "preset": target, "track": f"{artist} - {title}", "locked": bool(locked)}
        self.write_state()


def main():
    bus = Gio.bus_get_sync(Gio.BusType.SESSION)
    f = Follower()
    f.write_state()

    def on_config(_monitor, _file, _other, event):
        if event != Gio.FileMonitorEvent.CHANGED:  # yazım bitince (CHANGES_DONE_HINT, CREATED, DELETED) oku
            f.read_config()
            f.write_state()
            print(f"config.json değişti, mod: {f.config['mode']}", flush=True)

    monitor = Gio.File.new_for_path(CONFIG).monitor_file(Gio.FileMonitorFlags.NONE, None)
    monitor.connect("changed", on_config)

    def on_signal(_conn, _sender, _path, _iface, _signal, params):
        iface, changed, _ = params.unpack()
        if iface == "org.mpris.MediaPlayer2.Player" and "Metadata" in changed:
            f.on_metadata(changed["Metadata"])

    bus.signal_subscribe(MPRIS, "org.freedesktop.DBus.Properties", "PropertiesChanged",
                         "/org/mpris/MediaPlayer2", None, Gio.DBusSignalFlags.NONE, on_signal)
    try:  # servis açılırken Spotify zaten çalıyorsa
        md = bus.call_sync(MPRIS, "/org/mpris/MediaPlayer2", "org.freedesktop.DBus.Properties", "Get",
                           GLib.Variant("(ss)", ("org.mpris.MediaPlayer2.Player", "Metadata")),
                           None, Gio.DBusCallFlags.NONE, 2000, None)
        f.on_metadata(md.unpack()[0])
    except GLib.Error:
        print("Spotify kapalı, açılması bekleniyor", flush=True)
    if f.spotify:
        def retry():
            refresh()
            return False  # tek seferlik

        def refresh():
            def run():
                if not f.refresh_top():  # açılışta ağ henüz hazır değilse 5 dk sonra tekrar
                    GLib.timeout_add_seconds(300, retry)
            threading.Thread(target=run, daemon=True).start()
            return True  # 6 saatlik zamanlayıcı tekrarlasın
        refresh()
        GLib.timeout_add_seconds(6 * 3600, refresh)
    GLib.MainLoop().run()


if __name__ == "__main__":
    if sys.argv[1:2] == ["--login"]:
        login(sys.argv[2] if len(sys.argv) > 2 else ask_client_id())
    else:
        main()
